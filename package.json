{
  "name": "ai-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@remotion/bundler": "^4.0.535",
    "@remotion/captions": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "@remotion/media": "^4.0.535",
    "@remotion/player": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.535",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
